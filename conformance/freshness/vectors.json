      "case_id": "freshness.no_policy",
      "description": "Without a Freshness policy, even a malformed declared evidence time remains NOT_EVALUATED.",
      "expected": {
        "assurance_states": {
          "authorization": "NOT_EVALUATED",
          "binding_field_consistency": "VALID",
          "freshness": "NOT_EVALUATED",
          "invocation_binding_consistency": "VALID",
          "invocation_identity_consistency": "VALID",
          "payload_integrity": "VALID",
          "signature_validity": "ABSENT",
          "trusted_signer_identity": "UNESTABLISHED"
        },
        "expected_non_claims": [
          "trusted_historical_time_not_established"
        ],
        "rc": 0,
        "reason": "OK",
        "status": "VALID"
      },
      "input": {
        "bundle": "fixtures/bundles/malformed_timestamp",
        "options": []
      },
      "operation": "verify"
    },
    {
      "case_id": "freshness.complete_valid_policy",
